# =====================================================================
# 배포용 환경 변수 견본 — EC2 의 ~/app/.env 로 복사해서 실제 값을 채운다.
#   scp deploy/.env.example b102:~/app/.env   →  ssh b102 'chmod 600 ~/app/.env'
# 이 파일에는 키 이름과 설명만 둔다. 실제 값은 서버 .env 와 GitLab CI 변수에만 존재한다.
# docker compose 와 Spring(spring.config.import) 이 같은 파일을 읽는다.
# =====================================================================

# --- 이미지 -----------------------------------------------------------
# GitLab Container Registry 경로. CI 가 dev 머지마다 태그를 바꿔 push 한다.
BACKEND_IMAGE=registry.gitlab.com/<group>/<project>/backend
BACKEND_TAG=latest
ES_IMAGE=registry.gitlab.com/<group>/<project>/elasticsearch-nori
ES_TAG=8.19.21

# --- 도메인 / TLS ----------------------------------------------------------
DOMAIN=j15b102.p.ssafy.io
# certbot 만료 알림용. 팀 공용 메일 권장
LETSENCRYPT_EMAIL=

# --- PostgreSQL --------------------------------------------------------
# 컨테이너 초기화 시 1회만 반영된다. 나중에 바꾸면 볼륨을 지우거나 ALTER ROLE 로 직접 바꿔야 한다.
POSTGRES_DB=bookdb
POSTGRES_USER=book
POSTGRES_PASSWORD=                     # 32자 이상 랜덤. 예: openssl rand -base64 32
# 호스트에서 psql/pg_dump 로 붙을 때 쓰는 포트 (127.0.0.1 에만 바인딩된다)
POSTGRES_HOST_PORT=5432

# --- Elasticsearch -----------------------------------------------------
# 운영은 xpack.security 를 켠다. elastic 계정 비밀번호
ELASTIC_PASSWORD=                      # openssl rand -base64 32
ES_JAVA_OPTS=-Xms2g -Xmx2g            # 컨테이너 상한 4g 의 절반. 바꾸면 compose 상한도 같이

# --- Qdrant (추천 담당이 붙일 때까지 profile 로 꺼둠) -------------------
QDRANT_API_KEY=                        # 내부망만 쓰더라도 비워두지 말 것

# --- Spring backend ----------------------------------------------------
# compose 내부 네트워크 호스트명을 쓴다. localhost 아님.
DB_URL=jdbc:postgresql://postgres:5432/${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_POOL_SIZE=10
ES_URIS=http://elasticsearch:9200
ES_USERNAME=elastic
ES_PASSWORD=${ELASTIC_PASSWORD}
QDRANT_URL=http://qdrant:6333
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# 인증 (인증 담당이 키 이름을 확정하면 여기에 맞춘다)
JWT_SECRET=                            # 64바이트 이상. openssl rand -base64 64
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=1209600
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# 프론트 도메인. OAuth 콜백·CORS 허용 원본
FRONTEND_ORIGIN=https://${DOMAIN}

# 외부 도서 API (백엔드가 런타임에 직접 호출하는 것만. 수집 파이프라인 키는 ~/pipeline_data/.env 에 따로 있다)
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=

# --- 로깅 --------------------------------------------------------------
LOG_LEVEL_APP=INFO                     # 운영은 INFO. DEBUG 는 로그가 하루 수백 MB
