# =====================================================================
# 배포용 환경 변수 견본 — 서버의 deploy/.env 로 복사해서 실제 값을 채운다.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# 이 파일에는 키 이름과 설명만 둔다. 실제 값은 서버 deploy/.env 와 Jenkins credential 에만 존재한다.
# docker compose 가 읽고, Spring 으로는 compose 의 environment: 를 통해 전달된다.
# =====================================================================

# --- 릴리스 / 도메인 ---------------------------------------------------
RELEASE=latest                          # deploy.sh 가 git sha 로 덮어쓴다
DOMAIN=j15b102.p.ssafy.io
TLS_ENABLED=false                       # issue-cert.sh 성공 후 true
LETSENCRYPT_EMAIL=                      # 만료 알림. 팀 공용 메일 권장

# --- PostgreSQL --------------------------------------------------------
# 컨테이너 첫 초기화 때만 반영된다. 나중에 바꾸면 ALTER ROLE 로 직접.
POSTGRES_DB=bookdb
POSTGRES_USER=book
POSTGRES_PASSWORD=                      # openssl rand -base64 32
POSTGRES_HOST_PORT=5432                 # 호스트 127.0.0.1 에만 바인딩 (psql·pg_dump·적재용)
DB_POOL_SIZE=10

# --- Elasticsearch -----------------------------------------------------
ELASTIC_PASSWORD=                       # openssl rand -base64 32 . 운영은 xpack.security 켜짐
ES_JAVA_OPTS="-Xms2g -Xmx2g"            # 공백 포함 값은 따옴표. 컨테이너 상한 4g 의 절반. 바꾸면 compose mem_limit 도 같이

# --- Qdrant (profile recsys 로만 기동) ---------------------------------
QDRANT_API_KEY=                         # openssl rand -hex 32

# --- AI 추천 서버 -------------------------------------------------------
AI_PORT=8000                            # compose 내부 FastAPI 포트
AI_LOG_LEVEL=info                       # debug 로그에 요청 본문·비밀값을 넣지 않는다
AI_MODEL_VERSION=d4l-hybrid-v1
AI_INDEX_VERSION=none                   # 배치 promote 후 활성 index version으로 변경

# --- 인증 (인증 담당이 키 이름 확정 시 compose 와 함께 수정) -----------
JWT_SECRET=                             # openssl rand -base64 64
JWT_ACCESS_TTL_SECONDS=86400            # 24시간 고정, 갱신 토큰 없음 (API_SPEC §2.2)
JWT_REFRESH_TTL_SECONDS=1209600         # 예약. 백엔드는 아직 읽지 않는다
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# --- 외부 도서 API (백엔드가 런타임에 직접 호출하는 것만) ---------------
# 수집 파이프라인 키는 서버 ~/pipeline_data/.env 에 따로 있다.
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=

# --- 로깅 --------------------------------------------------------------
LOG_LEVEL_APP=INFO                      # DEBUG 는 하루 수백 MB. 운영은 INFO

# --- 백업 --------------------------------------------------------------
BACKUP_DIR=/var/lib/b102/backups          # root:b102 2770. ubuntu 크론과 jenkins 배포가 함께 쓴다 (setup-cd.sh 가 만듦)
