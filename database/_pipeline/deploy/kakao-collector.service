[Unit]
Description=카카오 도서 API 보강 수집기 (1회 실행 — 오늘 몫을 다 쓰면 종료)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/pipeline
Environment=PIPELINE_DATA=/home/ubuntu/pipeline_data
Environment=PYTHONUNBUFFERED=1

# **--wait 을 쓰지 않는다.** 타이머가 하루 두 번 깨우므로 프로세스가
# 자정까지 대기할 이유가 없다. 대기 루프는 상한 정지와 사용자 중단을
# 구분해야 하는 까다로운 코드라, 아예 안 타는 편이 안전하다
# (정보나루가 2026-09-02~03 에 그 루프로 이틀치를 날렸다).
ExecStart=/usr/bin/python3 scripts/enrich_from_kakao.py --workers 16

StandardOutput=append:/home/ubuntu/kakao.log
StandardError=append:/home/ubuntu/kakao.log

# 종료 신호를 받고 진행분을 fsync 할 시간
KillSignal=SIGINT
TimeoutStopSec=120

# 팀 공용 서버다. 자원을 독점하지 못하게 막는다
MemoryMax=3G
Nice=10
IOSchedulingClass=idle
