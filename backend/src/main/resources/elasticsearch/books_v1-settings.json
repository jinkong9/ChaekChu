{
  "index": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "analysis": {
    "char_filter": {
      "strip_space": {
        "type": "pattern_replace",
        "pattern": "\\s+",
        "replacement": ""
      }
    },
    "tokenizer": {
      "nori_mixed": {
        "type": "nori_tokenizer",
        "decompound_mode": "mixed"
      },
      "bigram_tokenizer": {
        "type": "ngram",
        "min_gram": 2,
        "max_gram": 2,
        "token_chars": ["letter", "digit"]
      }
    },
    "analyzer": {
      "korean": {
        "type": "custom",
        "tokenizer": "nori_mixed",
        "filter": ["nori_part_of_speech", "nori_readingform", "lowercase"]
      },
      "bigram": {
        "type": "custom",
        "char_filter": ["strip_space"],
        "tokenizer": "bigram_tokenizer",
        "filter": ["lowercase"]
      }
    }
  }
}
