# backend/.env 로 복사해서 사용. Spring 이 spring.config.import 로 직접 읽고, docker compose 도 같은 파일을 읽는다.
# 기본값은 docker-compose.yml 과 동일하므로 그대로 써도 된다.

# --- Spring 앱 ---
DB_URL=jdbc:postgresql://localhost:5432/bookdb
DB_USERNAME=book
DB_PASSWORD=book
ES_URIS=http://localhost:9200
SERVER_PORT=8080

# --- 인증 (API_SPEC §2). 비밀값은 .env 에만, 커밋 금지 ---
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef   # HS256, 32바이트 이상. 운영은 openssl rand -base64 48
JWT_ACCESS_TTL_SECONDS=86400                                  # 24시간 (명세 §2.2). 갱신 토큰 없음
FRONTEND_ORIGIN=http://localhost:5173                          # 콜백 후 302 목적지 ({FRONTEND_ORIGIN}/oauth/callback#accessToken=…)
# OAUTH_REDIRECT_BASE_URL=                                    # 보통 비움(요청 origin 사용). 프록시 뒤에서 콜백 주소가 http 로 잡히면 https://도메인
OAUTH_KAKAO_CLIENT_ID=                                        # 카카오 콘솔: 앱 → 플랫폼 키 → REST API 키
OAUTH_KAKAO_CLIENT_SECRET=                                    # 같은 화면의 클라이언트 시크릿
OAUTH_GOOGLE_CLIENT_ID=                                       # Google Cloud: OAuth 클라이언트(웹) ID
OAUTH_GOOGLE_CLIENT_SECRET=
