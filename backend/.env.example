# backend/.env 로 복사해서 사용. Spring 이 spring.config.import 로 직접 읽고, docker compose 도 같은 파일을 읽는다.
# 기본값은 docker-compose.yml 과 동일하므로 그대로 써도 된다.

# --- Spring 앱 ---
DB_URL=jdbc:postgresql://localhost:5432/bookdb
DB_USERNAME=book
DB_PASSWORD=book
ES_URIS=http://localhost:9200
SERVER_PORT=8080

# --- 인증 (API_SPEC §2). application.yml 연결은 인증 담당(#25·#27)이 한다. 값은 .env 에만, 커밋 금지 ---
# JWT_SECRET=            # HS256 비밀키, 32바이트 이상 (예: openssl rand -base64 48)
# FRONTEND_ORIGIN=http://localhost:5173   # OAuth 콜백 후 302 목적지 ({FRONTEND_ORIGIN}/oauth/callback#accessToken=…)
# OAUTH_KAKAO_CLIENT_ID=
# OAUTH_KAKAO_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# --- docker compose ---
POSTGRES_DB=bookdb
POSTGRES_USER=book
POSTGRES_PASSWORD=book
# 호스트에 PostgreSQL 이 이미 5432 를 쓰고 있으면(예: Windows 서비스) 5433 으로 바꾸고 DB_URL 포트도 맞춘다
POSTGRES_PORT=5432
